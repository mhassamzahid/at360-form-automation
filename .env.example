META_APP_ID=
META_APP_SECRET=
# Any random string; paste the same value into the Webhooks "Verify token" field
META_VERIFY_TOKEN=
# Your Facebook Page ID
META_PAGE_ID=
# Only act on these lead form IDs (comma-separated). Empty = all forms.
META_FORM_IDS=
# Page access token (run scripts/setup_page.py to get one from a system user token)
META_PAGE_ACCESS_TOKEN=
# Optional: used by scripts/setup_page.py
META_SYSTEM_USER_TOKEN=
META_GRAPH_VERSION=v27.0

# --- Email (Namecheap PrivateEmail SMTP) ---
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
# Full email address
SMTP_USERNAME=
# App password from PrivateEmail > Settings > Security center > App passwords
SMTP_PASSWORD=
EMAIL_FROM_NAME=AheadTech360
# Who gets the "new lead" email (comma-separated)
NOTIFY_EMAILS=
# Also send a "thanks" email to the person who filled the form
SEND_LEAD_CONFIRMATION=false
